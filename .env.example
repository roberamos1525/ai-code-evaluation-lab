# Copy to .env (never commit .env). Every setting can also come from a TOML file
# (see examples/configs/codeeval.toml) pointed to by CODEEVAL_CONFIG.

# State directory: experiment database (codeeval.db) lives here.
CODEEVAL_HOME=var
# CODEEVAL_DB_PATH=var/codeeval.db
# Extra directories scanned for *.jsonl datasets (comma separated).
# CODEEVAL_DATASET_DIRS=datasets

# Sandbox: local | docker | auto (docker when a daemon is reachable, else local).
CODEEVAL_SANDBOX_BACKEND=local
CODEEVAL_TIMEOUT_S=10
CODEEVAL_MEMORY_MB=512
CODEEVAL_MAX_OUTPUT_BYTES=65536
# AST policy: off | permissive | standard | strict
CODEEVAL_STRICTNESS=standard
CODEEVAL_WORKERS=4
# CODEEVAL_DOCKER_IMAGE=python:3.11-slim

# HTTP model adapters (openai, ollama) are disabled unless this is true.
CODEEVAL_ALLOW_NETWORK_ADAPTERS=false
# The openai adapter reads its key from the variable named by api_key_env (default OPENAI_API_KEY).
# OPENAI_API_KEY=

# API: comma-separated keys (>= 16 chars each). Empty = authentication disabled (local use only).
CODEEVAL_API_KEYS=
CODEEVAL_MAX_REQUEST_BYTES=1000000
CODEEVAL_MAX_CONCURRENT_RUNS=2
CODEEVAL_API_ALLOW_ADHOC=true

CODEEVAL_LOG_LEVEL=info
CODEEVAL_LOG_FORMAT=text
